std::vector<ArestaTIN> ImportEngine::importarArestas(const QString& caminho) {
    std::vector<ArestaTIN> listaArestas;
    QFile arquivo(caminho);
    if (!arquivo.open(QIODevice::ReadOnly | QIODevice::Text)) return listaArestas;

    QTextStream in(&arquivo);
    while (!in.atEnd()) {
        QString linha = in.readLine().trimmed();
        if (linha.isEmpty()) continue;

        // Supondo largura fixa (ex: 16 caracteres para cada ID)
        // Ou split por espaços se for variável
        QStringList partes = linha.split(QRegularExpression("\\s+"), Qt::SkipEmptyParts);
        
        if (partes.size() >= 2) {
            int id1 = partes[0].toInt();
            int id2 = partes[1].toInt();
            listaArestas.emplace_back(id1, id2);
        }
    }
    return listaArestas;
}

void GerenciadorDeArquivos::vincularArestas(Camada tipo, const QString& caminhoArs) {
    Superficie* s = obterSuperficie(tipo);
    if (!s) return;

    // 1. Criar um mapa rápido: ID do ponto -> Índice no vetor
    std::map<int, int> mapaIdParaIndice;
    for (int i = 0; i < (int)s->pontos.size(); ++i) {
        mapaIdParaIndice[s->pontos[i].nome.toInt()] = i;
    }

    // 2. Ler o arquivo .ars
    auto arestasBrutas = ImportEngine::importarArestas(caminhoArs);

    // 3. Converter IDs para Índices e salvar na superfície
    for (const auto& abruta : arestasBrutas) {
        if (mapaIdParaIndice.count(abruta.iIni) && mapaIdParaIndice.count(abruta.iFim)) {
            s->arestas.emplace_back(mapaIdParaIndice[abruta.iIni], 
                                    mapaIdParaIndice[abruta.iFim]);
        }
    }
}

