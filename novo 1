// 1. Definição Paramétrica (Pode vir de um .json ou .ini no futuro)
struct ParametrosLayout {
    QString extensao;
    char delimitador; // 0 se for largura fixa
    std::map<QString, std::pair<int, int>> campos; // "X" -> {inicio, largura}
};

// 2. Interface Abstrata para qualquer fonte de dados
class IProvedorPontos {
public:
    virtual ~IProvedorPontos() = default;
    virtual std::vector<Ponto> processar(const QString& caminho, const ParametrosLayout& params) = 0;
};

// 3. O Gerenciador agora trabalha com uma "Lista de Tarefas"
class GerenciadorDeArquivos {
    struct TarefaImportacao {
        QString caminho;
        Camada camadaDestino;
        ParametrosLayout params;
    };

    std::vector<TarefaImportacao> filaDeTrabalho;

public:
    void adicionarAFila(QString path, Camada cam, ParametrosLayout p) {
        filaDeTrabalho.push_back({path, cam, p});
    }

    // Rotina parametrizada que processa a lista completa
    void executarBatch(IProvedorPontos* processador) {
        for (const auto& tarefa : filaDeTrabalho) {
            auto pontos = processador->processar(tarefa.caminho, tarefa.params);
            // Aqui alimentamos a Superficie correspondente no repositório
            vincularPontosASuperficie(tarefa.camadaDestino, std::move(pontos));
        }
        filaDeTrabalho.clear();
    }
};

